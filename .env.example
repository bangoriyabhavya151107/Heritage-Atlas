SUPABASE_URL=
SUPABASE_SERVICE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=768
# Real runs use Gemini; unit tests inject the deterministic fake provider directly.
AI_PROVIDER=gemini
SEARCH_MIN_SIMILARITY=0.35
CORS_ORIGINS=http://localhost:3000

# Copy these public frontend settings to frontend/.env.local when running the web app.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
